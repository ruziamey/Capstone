{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeol-smart-stock-control",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./src/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
